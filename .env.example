# ─── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_DB_PASSWORD=your-supabase-db-password

# Full Postgres connection string (Supabase direct connection, port 5432)
# Format: Host=db.xxxx.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=<above>
DATABASE_URL=Host=db.your-project-id.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=your-supabase-db-password

# ─── App Secrets ─────────────────────────────────────────────
# Staff PIN JWT — min 32 chars, generate with: openssl rand -base64 32
STAFF_JWT_SECRET=your-staff-jwt-secret-min-32-characters

# ─── GitHub Container Registry ───────────────────────────────
# Set automatically by CI. Only needed for local pulls.
# Format: ghcr.io/phamhuutruong7/contactless-order-system
GHCR_PREFIX=ghcr.io/phamhuutruong7/contactless-order-system

# ─── Image tags (set by CI) ──────────────────────────────────
IMAGE_API=${GHCR_PREFIX}/api:latest
IMAGE_FRONTEND=${GHCR_PREFIX}/frontend:latest
